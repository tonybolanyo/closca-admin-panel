{
  "name": "closca-admin-panel",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:karma": "ng test",
    "update-badges": "node scripts/update-readme-badges.js",
    "test:coverage:update": "npm run test:coverage && npm run update-badges",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "e2e:playwright": "playwright test",
    "e2e:playwright:ui": "playwright test --ui",
    "e2e:playwright:headed": "playwright test --headed",
    "e2e:playwright:debug": "playwright test --debug",
    "e2e:playwright:report": "playwright show-report playwright-report",
    "build-prod": "ng build --configuration production",
    "build-pre": "ng build --configuration=pre",
    "build-develop": "ng build --configuration=develop"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.4",
    "@angular/cdk": "^20.2.8",
    "@angular/common": "^20.3.4",
    "@angular/compiler": "^20.3.4",
    "@angular/core": "^20.3.4",
    "@angular/forms": "^20.3.4",
    "@angular/google-maps": "^20.2.8",
    "@angular/material": "^20.2.8",
    "@angular/platform-browser": "^20.3.4",
    "@angular/platform-browser-dynamic": "^20.3.4",
    "@angular/router": "^20.3.4",
    "@auth0/angular-jwt": "^5.2.0",
    "@kolkov/angular-editor": "^3.0.0-beta.2",
    "@ks89/angular-modal-gallery": "^15.0.0-alpha.1",
    "@ng-bootstrap/ng-bootstrap": "^19.0.1",
    "@ng-select/ng-select": "^20.3.0",
    "@popperjs/core": "^2.11.8",
    "@tyris/angular-foundation": "file:./libs/tyris-angular-foundation-1.0.0.tgz",
    "apexcharts": "^5.3.5",
    "bootstrap": "^5.3.3",
    "core-js": "^3.41.0",
    "jquery": "^3.7.1",
    "lodash.clonedeep": "^4.5.0",
    "moment": "^2.30.1",
    "mousetrap": "^1.6.5",
    "ng-apexcharts": "^2.0.3",
    "ng2-file-upload": "^5.0.0",
    "ngx-toastr": "^19.1.0",
    "ngx-ui-loader": "^19.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.5",
    "@angular/cli": "^20.3.5",
    "@angular/compiler-cli": "^20.3.4",
    "@angular/language-service": "^20.3.4",
    "@playwright/test": "^1.56.0",
    "@types/googlemaps": "^3.43.3",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.15",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/mousetrap": "^1.6.15",
    "@types/node": "^22.10.5",
    "jasmine-core": "^5.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^15.0.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2"
  }
}
